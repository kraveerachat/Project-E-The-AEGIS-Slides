  "narrative": {
    "northStar": "Approved editorial presentation",
    "overview": "AEGIS uses the approved cream, violet, royal blue and coral editorial presentation world: oversized typography, asymmetric compositions, rounded panels and geometric arcs. The technical content stays legible against warm paper, while gradients connect major headings, actions and the active chapter capsule.\n\nOriginal university and project marks anchor the identity. Generated monument artwork is decorative; application captures and recordings have explicit evidence states. This records the implemented React presentation, with source CSS and component behavior taking precedence over earlier plans.",
    "keyCharacteristics": [
      "Oversized gradient headings and approved chapter identifiers.",
      "Warm cream canvas, dark navy text and softly tinted panels.",
      "Asymmetric editorial layouts with circular arcs and restrained ambient depth.",
      "Fixed recording composition with a separate reflowing reading mode.",
      "Evidence labels and optional motion remain part of the interface."
    ],
    "rules": [
      {
        "name": "The Evidence State Rule",
        "body": "Keep reported, limited and pending states explicit in words; color alone never establishes evidence.",
        "section": "colors"
      },
      {
        "name": "The Recording Frame Rule",
        "body": "Compose presentation mode at 1920 × 1080 and scale the complete stage uniformly; use reading mode for reflow.",
        "section": "layout"
      },
      {
        "name": "The Optional Motion Rule",
        "body": "System reduced motion and the motion control suppress scene animation, chapter morphing, parallax and decorative diagram flow.",
        "section": "components"
      }
    ],
    "dos": [
      "Do retain the approved large gradient headings, rounded panels and chapter identifiers.",
      "Do preserve the supplied original marks and keep generated artwork identified as illustrative.",
      "Do use semantic controls, visible focus and explicit selected or pressed states.",
      "Do maintain 16:9 media stages and readable missing or unavailable messages."
    ],
    "donts": [
      "Don't present decorative diagram flow as live telemetry.",
      "Don't substitute generated application screens for original system evidence.",
      "Don't auto-advance scenes or autoplay recordings."
    ]
  }
}
