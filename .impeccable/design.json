      "css": ".ds-primary{font-family:'Manrope Variable', 'Noto Sans Thai', sans-serif;background:var(--gradient,linear-gradient(115deg,#a456f3,#652ced 54%,#374eff));color:white;border:0;display:inline-flex;align-items:center;gap:32px;border-radius:55px;padding:23px 27px 23px 38px;font-size:26px;font-weight:650;box-shadow:0 15px 32px -13px #7543ce7d;cursor:pointer;transition:box-shadow .16s ease}.ds-primary span{width:43px;height:43px;background:#30139735;border-radius:50%;display:grid;place-items:center}.ds-primary:hover{box-shadow:0 20px 36px -13px #7543cea0}.ds-primary:active{filter:brightness(.97)}.ds-primary:focus-visible{outline:3px solid var(--purple-deep,#4d22cc);outline-offset:5px}"
